# Copy this file to .env and fill in your own Supabase project's values.
# Dashboard → Project Settings → API. The anon key is safe to expose in the
# browser — it can only do what the Row Level Security policies in
# supabase/schema.sql allow (customers can only insert orders; only a
# logged-in admin can read/update/delete them).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
